A32_ADMIN_PASSWORD=replace-with-random-password-at-least-12-characters
A32_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
A32_BRIDGE_URL=https://a32.example.com
A32_BRIDGE_TOKEN=replace-with-random-token-at-least-32-characters
